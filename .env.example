NODE_ENV=development

# HTTP
GATEWAY_PORT=3100
REALTIME_PORT=3101
WEB_PORT=5180

# Auth
JWT_SECRET=pulsex-dev-secret-change-me
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# Demo login (adapter fallback when legacy PHP is not connected)
DEMO_ACCOUNT=yanhuaichuan
DEMO_PASSWORD=pulsex

# MySQL (legacy transactional database — do not replace in phase 1)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pulsex
DB_USER=root
DB_PASSWORD=
DB_PREFIX=zt_

# Legacy PHP API (optional strangler adapter)
LEGACY_API_URL=
LEGACY_API_TOKEN=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# AI (never log these values)
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# DingTalk (never commit real secrets)
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
